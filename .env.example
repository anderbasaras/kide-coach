# Kide configuration. Copy to `.env` and fill in your own values.
# `.env` is git-ignored: never commit it.

# --- Telegram -------------------------------------------------------------
# Token from @BotFather (/newbot). Required to run the bot.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to talk to the bot, e.g. 123456789,-1001234567890
# The first one is the main chat: it receives the scheduled daily check-in.
# All allowed chats share the same profile (one instance = one person).
# Every other chat is ignored without a reply and logged (chat id only, never the text).
# Don't know your chat id? Set ALLOWED_CHAT_IDS=1, run `uv run kide run`, write to your
# bot and copy the chat_id from the "Ignored update from unauthorized chat" log line.
ALLOWED_CHAT_IDS=

# --- Anthropic ------------------------------------------------------------
# API key from https://platform.claude.com/settings/keys (Claude Console). It is billed
# separately from a claude.ai subscription. Needed for WOD parsing and the coach chat.
ANTHROPIC_API_KEY=

# Claude models. Check the current names and prices at https://docs.claude.com before
# setting them. Without a key and a model the bot still works, but WODs and activities
# are saved without interpretation and there is no coach chat.
# Run `uv run kide llm check` to test them and `uv run kide llm costs` to see the spend.
#
# Model for the coach chat, e.g. claude-opus-5-5 (best answers) or claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Optional model for reading WODs and activities (text and board photos).
# Empty = same as ANTHROPIC_MODEL. A cheaper model such as claude-haiku-5-5 may be
# accurate enough: compare them on your own boards with `uv run kide eval`.
ANTHROPIC_PARSE_MODEL=

# --- Storage --------------------------------------------------------------
# Folder for your personal data: SQLite database, photos, exports. Git-ignored.
DATA_DIR=./var

# SQLAlchemy URL. Leave empty to use $DATA_DIR/kide.db.
DATABASE_URL=

# --- Profile --------------------------------------------------------------
# Your profile. Start from profile.example.yaml. Git-ignored.
PROFILE_PATH=./profile.yaml

# --- Logging --------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
